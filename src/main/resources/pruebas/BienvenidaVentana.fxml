<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="nuevo_boton" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="300.0" prefWidth="400.0" spacing="20.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pruebas.BienvenidaController">
   <children>
      <Button mnemonicParsing="false" text="Button" />
      <Label text="Introduce tu nombre:">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="nombreTextField" maxWidth="200.0" promptText="Tu nombre aquí" />
      <Button fx:id="saludarButton" mnemonicParsing="false" onAction="#onSaludarButtonClick" text="Enviar Saludo" />
      <Label fx:id="mensajeLabel">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
